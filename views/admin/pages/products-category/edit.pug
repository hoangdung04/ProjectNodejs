extends ../../layouts/default.pug
include ../../mixin/alert.pug
include ../../mixin/select-tree.pug

block main
  h1(class="mb-4") Danh mục sản phẩm
  +alert-error(3000)
  form(
    action=`${prefixAdmin}/products-category/edit/${product.id}?_method=PATCH`
    id="form-edit-products"
    method="POST"
    enctype="multipart/form-data"
  )
    div(class="form-group")
      label(for="title") Tiêu đề
      input(
        type="text"
        class="form-control"
        id="title"
        name="title"
        required
        value=product.title
      )
    div(class="form-group")
      label(for="parent_id") Danh mục cha
      select(
        name="parent_id"
        id="parent_id"
        class="form-control"
      )
        option(value="") ---Chọn danh mục cha---
        +select-tree(productsCategory, 1, product.parent_id)
    div(class="form-group")
      label(for="desc") Mô tả
      textarea(
        class="form-control textAreaMce"
        id="desc"
        name="description"
        rows="5"
        value=product.description
      
      )
    div(class="form-group" upload-image)
      label(for="thumbnail") Ảnh
      input(
        type="file"
        class="form-control-file"
        id="thumbnail"
        name="thumbnail"
        accept="image/*"
        upload-image-input
        value=product.thumbnail
      )
      img(
        src=product.thumbnail 
        upload-image-preview
        class="image-preview"
      )
      span(class="close-preview" close-image-preview) x

    div(class="form-group")
      label(for="position") Vị trí
      input(
        type="number"
        class="form-control"
        id="position"
        name="position"
        placeholder="Tự động tăng"
        min="1"
        value=product.position
      )
    div(class="form-group form-check form-check-inline")
      input(
        type="radio"
        class="form-check-input"
        id="statusActive"
        name="status"
        value="active"
        checked=(product.status === "active")
      )
      label(for="statusActive" class="form-check-label") Hoạt động
    div(class="form-group form-check form-check-inline")
      input(
        type="radio"
        class="form-check-input"
        id="statusInActive"
        name="status"
        value="inactive"
        checked=(product.status === "inactive")
      )
      label(for="statusInActive" class="form-check-label") Dừng hoạt động
    div(class="form-group")
      button(
        type="submit"
        class="btn btn-primary"
      ) Cập nhật

  script(src="/admin/js/product.js")