extends ../../layouts/default.pug
include ../../mixin/alert.pug

block main
  if(role.permissions.includes("products-category_edit"))
    h1(class="mb-4") Phân quyền

    +alert-success(3000)
    +alert-error(3000)

    if(records)
      div(data-records=JSON.stringify(records) class="d-none")

    .permissions-wrapper
      .permissions-submit-bar
        button(type="submit" class="button-submit" button-submit)
          span(class="icon-check") ✓
          | Cập nhật

      .permissions-table-wrap
        table(class="permissions-table" table-permissions)
            thead
              tr
                th Tính năng
                each record in records
                  th
                    span(class="role-badge") #{record.title}

            tbody
              tr(data-name="id")
                td ID
                each record in records
                  td
                    input(type="text" value=record._id class="d-none")
              //- ── Danh mục sản phẩm ─────────────────────────
              tr(class="group-header")
                td(colspan=`${records.length + 1}`) Danh mục sản phẩm
              tr(class="perm-row-even" data-name="products-category_view")
                td Xem
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="products-category_view" checked=record.permissions && record.permissions.includes("products-category_view"))

              tr(data-name="products-category_create")
                td Thêm mới
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="products-category_create" checked=record.permissions && record.permissions.includes("products-category_create"))

              tr(class="perm-row-even" data-name="products-category_edit")
                td Chỉnh sửa
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="products-category_edit" checked=record.permissions && record.permissions.includes("products-category_edit"))

              tr(data-name="products-category_delete")
                td Xóa
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="products-category_delete" checked=record.permissions && record.permissions.includes("products-category_delete"))

              //- ── Sản phẩm ──────────────────────────────────
              tr(class="group-header")
                td(colspan=`${records.length + 1}`) Sản phẩm

              tr(class="perm-row-even" data-name="products_view")
                td Xem
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="products_view" checked=record.permissions && record.permissions.includes("products_view"))

              tr(data-name="products_create")
                td Thêm mới
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="products_create" checked=record.permissions && record.permissions.includes("products_create"))

              tr(class="perm-row-even" data-name="products_edit")
                td Chỉnh sửa
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="products_edit" checked=record.permissions && record.permissions.includes("products_edit"))

              tr(data-name="products_delete")
                td Xóa
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="products_delete" checked=record.permissions && record.permissions.includes("products_delete"))

              //- ── Nhóm quyền ────────────────────────────────
              tr(class="group-header")
                td(colspan=`${records.length + 1}`) Nhóm quyền

              tr(class="perm-row-even" data-name="roles_view")
                td Xem
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="roles_view" checked=record.permissions && record.permissions.includes("roles_view"))

              tr(data-name="roles_create")
                td Thêm mới
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="roles_create" checked=record.permissions && record.permissions.includes("roles_create"))

              tr(class="perm-row-even" data-name="roles_edit")
                td Chỉnh sửa
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="roles_edit" checked=record.permissions && record.permissions.includes("roles_edit"))

              tr(data-name="roles_delete")
                td Xóa
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="roles_delete" checked=record.permissions && record.permissions.includes("roles_delete"))
              tr(data-name="roles_permissions")
                td Phân quyền
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="roles_permissions" checked=record.permissions && record.permissions.includes("roles_permissions"))
              //- ── Tài khoản ──────────────────────────────────
              tr(class="group-header")
                td(colspan=`${records.length + 1}`) Tài khoản

              tr(class="perm-row-even" data-name="accounts_view")
                td Xem
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="accounts_view" checked=record.permissions && record.permissions.includes("accounts_view"))

              tr(data-name="accounts_create")
                td Thêm mới
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="accounts_create" checked=record.permissions && record.permissions.includes("accounts_create"))

              tr(class="perm-row-even" data-name="accounts_edit")
                td Chỉnh sửa
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="accounts_edit" checked=record.permissions && record.permissions.includes("accounts_edit"))

              tr(data-name="accounts_delete")
                td Xóa
                each record in records
                  td
                    input(type="checkbox" name=`permissions[${record._id}][]` value="accounts_delete" checked=record.permissions && record.permissions.includes("accounts_delete"))
        

    form(
      id="form-change-permissions"
      method="POST"
      action=`${prefixAdmin}/roles/permissions?_method=PATCH`
      class="d-none"
    )
      div(class="form-group")
        input(
          type="text"
          class="form-control"
          name="permissions"
        )

    script(src="/admin/js/roles.js")
  else 
    h1 Bạn không có quyền truy cập