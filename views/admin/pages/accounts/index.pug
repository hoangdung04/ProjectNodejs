extends ../../layouts/default.pug
include ../../mixin/alert.pug
block main
  if(role.permissions.includes("accounts_view"))
    +alert-success(5000)
    +alert-error(5000)

    h1(class="mb-4") Danh sách tài khoản

    .card.mb-3
      .card-header Danh sách
      .card-body
        .row
          .col-8
          .col-4.text-right
            a(
              href=`${prefixAdmin}/accounts/create`
              class="btn btn-outline-success"
            ) + Thêm mới

      .card-body
        table(class="table table-bordered")
          thead
            tr
              th STT
              th Ảnh
              th Họ và tên
              th Email
              th Vai trò
              th Trạng thái
              th Hành động

          tbody
            each record, index in records
              tr
                td #{index + 1}
                td
                  img(src=record.avatar, alt="", width="100")
                td #{record.fullName}
                td #{record.email}
                td #{record.role.title}
                td 
                  if (record.status == "active")
                    a(href="javascript:;" class="badge badge-success" button-change-status data-id=record.id data-status=record.status) Hoạt động
                  else 
                    a(href="javascript:;" class="badge badge-danger" button-change-status data-id=record.id data-status=record.status) Dừng hoạt động
                td
                  a(
                    href=`${prefixAdmin}/accounts/edit/${record.id}`
                    class="btn btn-warning"
                  ) Sửa
                  a(
                    href=`${prefixAdmin}/accounts/delete/${record.id}`
                    class="btn btn-danger"
                  ) Xóa
  else 
    h1 Bạn không có quyền truy cập