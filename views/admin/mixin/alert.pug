mixin alert-success(time)
 if (messages.success)
    .show-alert
      .message.info
        div(
          class="alert alert-success"
          role="alert"
          show-alert
          data-time=time
        ) #{messages.success} <span close-alert>x</span>


mixin alert-error(time)
 if (messages.error)
    .show-alert
      .message.info
        div(
          class="alert alert-error"
          role="alert"
          show-alert
          data-time=time
        ) #{messages.error} <span close-alert>x</span>