extends ../../layouts/default.pug
include ../../mixin/box-head.pug

block main
  .container.my-3 
    .row
     .col-12
       +box-head("Danh sách sản phẩm")

    .row
      each item in products
        .col-4.mb-3 
          .product-item
            .product-image
              img(src=item.thumbnail, alt="Product")
              .inner-discount -#{item.discountPercentage}%
            .product-info
              h3.product-title #{item.title}
              p.product-price #{item.priceNew}$
              p.product-price-old #{item.price}$
              a.product-btn Mua hàng